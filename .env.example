# PostgreSQL (local default matches docker-compose.yml)
APP_DOMAIN=localhost:3000
DATABASE_URL=postgresql://litrito:litrito@127.0.0.1:5432/litrito
POSTGRES_DB=litrito
POSTGRES_USER=litrito
POSTGRES_PASSWORD=litrito

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
# Generate at least 32 random bytes; never commit a production value.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Optional analytics
VITE_UMAMI_SRC=https://umami.athas.mx/script.js
VITE_UMAMI_WEBSITE_ID=

# Optional alternate OpenStreetMap Overpass endpoint for admin brand audits.
OVERPASS_URL=https://overpass.kumi.systems/api/interpreter

# SMTP email provider. Works with Brevo, Mailgun, Postmark SMTP, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional. Inferred as true for port 465, false otherwise.
SMTP_SECURE=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Litrito

# Sentry (error monitoring)
# Public client DSN. A default is baked in; only set this to point at a
# different Sentry project. Safe to commit (DSNs are public).
VITE_SENTRY_DSN=
# Set to 1 to enable Sentry in local dev (off by default to avoid HMR noise).
VITE_SENTRY_FORCE=
# SECRET — never commit. Only needed to upload source maps at build time so
# production stack traces are readable. Create an Organization Auth Token at
# Sentry → Settings → Auth Tokens (scopes: project:releases, project:write).
SENTRY_AUTH_TOKEN=
# Org/project slugs for the source-map upload (defaults: litrito / javascript-tanstackstart-react).
SENTRY_ORG=
SENTRY_PROJECT=
