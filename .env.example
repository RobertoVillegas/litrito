# Convex
# Convex deployment name
CONVEX_DEPLOYMENT=
# Convex deployment URL (required)
VITE_CONVEX_URL=

# SMTP email provider. Works with Brevo, Mailgun, Postmark SMTP, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional. Inferred as true for port 465, false otherwise.
SMTP_SECURE=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Litrito

# Sentry (error monitoring)
# Public client DSN. A default is baked in; only set this to point at a
# different Sentry project. Safe to commit (DSNs are public).
VITE_SENTRY_DSN=
# Set to 1 to enable Sentry in local dev (off by default to avoid HMR noise).
VITE_SENTRY_FORCE=
# SECRET — never commit. Only needed to upload source maps at build time so
# production stack traces are readable. Create an Organization Auth Token at
# Sentry → Settings → Auth Tokens (scopes: project:releases, project:write).
SENTRY_AUTH_TOKEN=
# Org/project slugs for the source-map upload (defaults: litrito / javascript-tanstackstart-react).
SENTRY_ORG=
SENTRY_PROJECT=
