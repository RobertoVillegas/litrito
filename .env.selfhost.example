# Copy to .env.selfhost and pass with: docker compose --env-file .env.selfhost ...
# These configure the self-hosted backend in docker-compose.yml.

# Public URLs the browser and `npx convex deploy` use to reach the backend.
# Local trial (defaults — you can leave these as-is):
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211

# On a VPS, expose the backend behind a reverse proxy and set, e.g.:
# CONVEX_CLOUD_ORIGIN=https://convex.litrito.mx
# CONVEX_SITE_ORIGIN=https://convex-http.litrito.mx

# Names this instance. Set a long random INSTANCE_SECRET for a real deployment.
INSTANCE_NAME=litrito
INSTANCE_SECRET=

# SMTP email provider. For Brevo, use host smtp-relay.brevo.com and port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional. Inferred as true for port 465, false otherwise.
SMTP_SECURE=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Litrito

# --- Optional: use Postgres as the storage engine instead of bundled SQLite ---
# POSTGRES_URL=postgres://user:password@db-host:5432/litrito_convex
# DO_NOT_REQUIRE_SSL=true
