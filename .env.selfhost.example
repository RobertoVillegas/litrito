# Copy to .env.selfhost and pass with: docker compose --env-file .env.selfhost ...

# PostgreSQL. Use a long random password in Dokploy.
APP_DOMAIN=litrito.com
POSTGRES_DB=litrito
POSTGRES_USER=litrito
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://litrito:CHANGE_ME@postgres:5432/litrito
MIGRATION_DATA_DIR=/opt/litrito-migration

# Better Auth. Generate a new secret of at least 32 random bytes.
BETTER_AUTH_URL=https://litrito.com
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

VITE_UMAMI_SRC=https://umami.athas.mx/script.js
VITE_UMAMI_WEBSITE_ID=
OVERPASS_URL=https://overpass.kumi.systems/api/interpreter

# SMTP email provider. For Brevo, use host smtp-relay.brevo.com and port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional. Inferred as true for port 465, false otherwise.
SMTP_SECURE=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Litrito
